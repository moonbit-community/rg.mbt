///|
/// Translates a WASI preview1 errno into the corresponding Linux errno.
fn wasi_errno_to_linux(e : Int32) -> Int32 {
  match e {
    1 => 7 // 2big
    2 => 13 // acces
    3 => 98 // addrinuse
    4 => 99 // addrnotavail
    5 => 97 // afnosupport
    6 => 11 // again
    7 => 114 // already
    8 => 9 // badf
    9 => 74 // badmsg
    10 => 16 // busy
    11 => 125 // canceled
    12 => 10 // child
    13 => 103 // connaborted
    14 => 111 // connrefused
    15 => 104 // connreset
    16 => 35 // deadlk
    17 => 89 // destaddrreq
    18 => 33 // dom
    19 => 122 // dquot
    20 => 17 // exist
    21 => 14 // fault
    22 => 27 // fbig
    23 => 113 // hostunreach
    24 => 43 // idrm
    25 => 84 // ilseq
    26 => 115 // inprogress
    27 => 4 // intr
    28 => 22 // inval
    29 => 5 // io
    30 => 106 // isconn
    31 => 21 // isdir
    32 => 40 // loop
    33 => 24 // mfile
    34 => 31 // mlink
    35 => 90 // msgsize
    36 => 72 // multihop
    37 => 36 // nametoolong
    38 => 100 // netdown
    39 => 102 // netreset
    40 => 101 // netunreach
    41 => 23 // nfile
    42 => 105 // nobufs
    43 => 19 // nodev
    44 => 2 // noent
    45 => 8 // noexec
    46 => 37 // nolck
    47 => 67 // nolink
    48 => 12 // nomem
    49 => 42 // nomsg
    50 => 92 // noprotoopt
    51 => 28 // nospc
    52 => 38 // nosys
    53 => 107 // notconn
    54 => 20 // notdir
    55 => 39 // notempty
    56 => 131 // notrecoverable
    57 => 88 // notsock
    58 => 95 // notsup
    59 => 25 // notty
    60 => 6 // nxio
    61 => 75 // overflow
    62 => 130 // ownerdead
    63 => 1 // perm
    64 => 32 // pipe
    65 => 71 // proto
    66 => 93 // protonosupport
    67 => 91 // prototype
    68 => 34 // range
    69 => 30 // rofs
    70 => 29 // spipe
    71 => 3 // srch
    72 => 116 // stale
    73 => 110 // timedout
    74 => 26 // txtbsy
    75 => 18 // xdev
    76 => 13 // notcapable: no Linux equivalent, report as EACCES
    _ => e
  }
}
